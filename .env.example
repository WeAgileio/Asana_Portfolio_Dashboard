# 複製此檔案為 .env.local 並填入你的資料
# Copy this file to .env.local and fill in your values

# ───────────────── 前端設定（Vite） ─────────────────
# 選填：個人權杖儲存至 localStorage 時的加密金鑰（建議正式環境設定隨機字串）
# 未設定時使用預設值，權杖仍會加密儲存
# VITE_STORAGE_ENCRYPT_KEY=

# 預設顯示的 Asana 專案 GID（可在 Asana URL 中取得）
# 例如：https://app.asana.com/0/1234567890123456/list → GID 為 1234567890123456
VITE_DEFAULT_PROJECT_GID=

# 自動重新載入資料的間隔（分鐘），預設 10。設為 0 可關閉自動重新載入
 VITE_REFRESH_INTERVAL_MINUTES=10

# ───────────────── 後端設定（OAuth） ─────────────────
# 這些變數會被 Node/Express 後端使用，用來走 Asana OAuth 2.0 授權流程
# 建議建立一個 .env（或 .env.server）給後端使用

# 在 Asana 開發者後台建立一個 OAuth App，填入下面資訊：
# https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# OAuth Redirect URI（需與 Asana App 設定完全一致）
# 開發環境預設使用 Vite dev server：
#   http://localhost:5173/auth/asana/callback
ASANA_REDIRECT_URI=http://localhost:5173/auth/asana/callback

# 用來加密登入 session 的隨機字串，請自行修改為更長更安全的值
SESSION_SECRET=please_change_this_to_a_long_random_string

# 選填：預設個人權杖（PAT）。若設定，未登入時會自動使用此 token 呼叫 API，無需手動登入
# 取得方式：https://app.asana.com/0/my-apps
 ASANA_DEFAULT_PAT=